# ── Supabase ──
# Crear proyecto en https://supabase.com y copiar los valores desde Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AWS S3 (imágenes clínicas) ──
# Crear bucket en AWS S3 y generar las credenciales correspondientes
AWS_BUCKET=OptiFlow-images

# ── Google Maps ──
# Obtener API Key desde https://console.cloud.google.com → APIs & Services → Credentials
MAPS_API_KEY=your-google-maps-api-key
