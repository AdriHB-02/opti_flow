# ── Supabase ──
# Crear proyecto en https://supabase.com y copiar los valores desde Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ── AWS S3 (imágenes clínicas) ──
# Crear bucket en AWS S3 y generar las credenciales correspondientes
AWS_BUCKET=OptiFlow-images

# ── Google Maps ──
# Obtener API Key desde https://console.cloud.google.com → APIs & Services → Credentials
MAPS_API_KEY=your-google-maps-api-key

# ── Supabase Storage (logo del login) ──
# 1. Crear bucket 'logos' público en Supabase Dashboard → Storage
# 2. Subir la imagen del logo
# 3. Copiar la URL pública del objeto
LOGIN_LOGO_URL=https://your-project.supabase.co/storage/v1/object/public/logos/your-logo.png

# ── Google OAuth 2.0 (Native Sign-In) ──
# 1. Crear proyecto en Google Cloud Console
# 2. Habilitar Google Identity Services
# 3. Web Client ID: Credentials > OAuth 2.0 > Web Application
# 4. iOS Client ID: Credentials > OAuth 2.0 > iOS (bundle ID: com.optiflow.optiFlow)
# 5. Android: configurar con package name com.optiflow.opti_flow + SHA-1
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
